{
  "expo": {
    "name": "Money Manager",
    "slug": "money-manager",
    "version": "1.1.0",
    "orientation": "portrait",

    "icon": "./assets/app.png",
    "scheme": "money-manager",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/app.png",
      "bundleIdentifier": "com.amm0x01.moneymanager",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/app.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amm0x01.moneymanager"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/app.png",
          "imageWidth": 80
        }
      ],
      "expo-font",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f15b1cee-9584-4261-8242-acefbb3b9e84"
      }
    }
  }
}
